[Unit]
Description=Back up and verify the Dilemma database
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/dilemma/backup-production.py --production-directory-file /etc/dilemma/backup-production-directory --verify-restore --rotate-daily
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/dilemma/backups
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dilemma-db-backup
