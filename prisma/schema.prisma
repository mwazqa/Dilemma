generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizSettlement {
  messageId       String    @id
  guildId         String
  channelId       String
  difficulty      String
  correctAnswerId Int
  answerIds       String
  expiresAt       DateTime
  closedAt        DateTime?
  scoredAt        DateTime?
  resultsPending  Boolean   @default(true)
  votingMode      String    @default("native")
  finalCounts     String?
  nextCheckAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  answers         QuizAnswer[]
  votes           QuizVote[]
  supports        QuizSupport[]
  wagers          QuizWager[]
  charges         QuizCharge[]
  correction      QuizCorrection?

  @@index([scoredAt, nextCheckAt])
  @@index([resultsPending, nextCheckAt])
  @@index([guildId])
}

model QuizAnswer {
  messageId  String
  userId     String
  guildId    String
  answerId   Int
  correct    Boolean
  baseExp    Int @default(0)
  sparksPenalty Int @default(0)
  streakExp  Int @default(0)
  streakProtected Boolean @default(false)
  finishedAt DateTime
  settlement QuizSettlement @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([guildId, userId, finishedAt, messageId])
}

model UserScore {
  guildId       String
  userId        String
  exp           BigInt   @default(0)
  answered      Int      @default(0)
  correct       Int      @default(0)
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  selectedBadge String?
  sparks        Int      @default(0)
  updatedAt     DateTime @updatedAt
  exchanges     SparkExchange[]

  @@id([guildId, userId])
  @@index([guildId, exp(sort: Desc), correct(sort: Desc), userId])
}

model SparkExchange {
  interactionId String @id
  guildId       String
  userId        String
  sparksSpent   Int
  expGained     Int
  sparksAfter   Int
  levelAfter    Int
  levelReward   Int
  player        UserScore @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

  @@index([guildId, userId])
}


model SparkTransfer {
  interactionId   String   @id
  guildId         String
  senderUserId    String?
  recipientUserId String?
  amount          Int
  createdAt       DateTime @default(now())

  @@index([guildId, senderUserId])
  @@index([guildId, recipientUserId])
}

model DailyQuizRun {
  guildId   String
  scope     String
  day       String
  slot      Int
  messageId String?
  createdAt DateTime @default(now())

  @@id([guildId, scope, day, slot])
}

model Topic {
  id             String   @id @default(cuid())
  guildId        String
  name           String
  language       String   @default("en")
  difficulty     String   @default("medium")
  intervalDays   Int      @default(1)
  pollDurationHours Int   @default(24)
  options        String
  optionCount    Int      @default(4)
  questionsGenerated Int   @default(0)
  channelId      String?
  pingRoleId     String?
  enabled        Boolean  @default(true)
  nextGenerationAt DateTime?
  generationTime String?
  startDate      String?
  lastGeneratedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([guildId, name])
  @@index([guildId])
}

model QuizChannel {
  guildId   String
  channelId String

  @@id([guildId, channelId])
}

model GuildSettings {
  guildId   String   @id
  managerRoleId String?
  randomPingRoleId String?
  randomCooldownResetAt DateTime?
  timezone String?
  language          String   @default("en")
  defaultIntervalDays Int    @default(1)
  defaultPollDurationHours Int @default(24)
  defaultGenerationTime String?
  defaultDifficulty String @default("medium")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GeneratedPoll {
  difficulty    String    @default("medium")
  id            String    @id @default(cuid())
  guildId       String
  topicId       String
  messageId     String    @unique
  channelId     String
  question     String
  options      String
  correctOption Int
  explanation  String
  topicEmoji   String    @default("✨")
  optionEmojis String    @default("")
  createdAt    DateTime  @default(now())
  endedAt      DateTime?
  closedAt     DateTime?
  closedByUserId String?
  closeSource  String?

  @@index([guildId, createdAt])
  @@index([guildId, topicId, createdAt])
}

model RandomPoll {
  kind          String    @default("random")
  difficulty    String    @default("medium")
  id            String    @id @default(cuid())
  guildId       String
  language      String
  category      String?
  messageId     String    @unique
  channelId     String
  creatorUserId String?
  readyPingSentAt DateTime?
  question      String
  options       String
  correctOption Int
  explanation   String
  optionEmojis  String    @default("")
  createdAt     DateTime  @default(now())
  endedAt       DateTime?
  closedAt      DateTime?
  closedByUserId String?
  closeSource   String?

  @@index([guildId, createdAt])
  @@index([guildId, kind, createdAt])
}

model QuizVote {
  messageId String
  userId    String
  guildId   String
  answerId  Int
  settlement QuizSettlement @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([guildId, userId])
}

model QuizSupport {
  messageId String
  userId    String
  guildId   String
  revealed Boolean @default(false)
  hintAnswerIds String?
  settlement QuizSettlement @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([guildId, userId])
}

model QuizWeeklyToolUse {
  guildId   String
  userId    String
  kind      String
  weekStart String

  @@id([guildId, userId, kind])
}

model QuizWager {
  messageId String
  userId    String
  guildId   String
  answerId  Int
  amount    Int
  payout    Int?
  settlement QuizSettlement @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([guildId, userId])
}

model QuizCharge {
  messageId  String
  userId     String
  fees       Int
  settlement QuizSettlement @relation(fields: [messageId], references: [messageId], onDelete: Cascade, onUpdate: Cascade)

  @@id([messageId, userId])
}

model QuizCorrection {
  messageId        String    @id
  reportId         String
  text             String
  approvedAt       DateTime  @default(now())
  publishedAt      DateTime?
  refundedSparks   BigInt
  refundedPlayers  Int
  settlement       QuizSettlement @relation(fields: [messageId], references: [messageId], onDelete: Cascade, onUpdate: Cascade)
  refunds          QuizRefund[]

  @@index([publishedAt, approvedAt])
}

model QuizRefund {
  messageId  String
  userId     String
  penalty    Int
  stake      Int
  fees       Int
  correction QuizCorrection @relation(fields: [messageId], references: [messageId], onDelete: Cascade, onUpdate: Cascade)

  @@id([messageId, userId])
}

model QuizGenerationRule {
  key       String   @id
  text      String
  createdAt DateTime @default(now())
}

model QuizReport {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String
  reporterUserId String
  reason         String
  source         String
  question       String
  options        String
  correctOption  Int
  explanation    String
  difficulty     String
  quizCreatedAt  DateTime
  createdAt      DateTime @default(now())
  reviewedAt     DateTime?
  reviewNote     String?
  analysis       String?
  analyzedAt     DateTime?

  @@unique([messageId, reporterUserId])
  @@index([reviewedAt, createdAt, id])
}

model GuidePublication {
  messageId String   @id
  guildId   String
  channelId String
  active    Boolean  @default(true)
  genericAt DateTime?
  contentHash String?
  createdAt DateTime @default(now())

  @@index([active, guildId, channelId])
  @@index([genericAt])
}

model GuideReleaseNotice {
  guildId     String
  channelId   String
  version     String
  messageId   String?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  @@id([guildId, channelId, version])
}

model GuideDiscovery {
  channelId       String
  kind            String   @default("messages")
  guildId         String
  cursor          String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@id([channelId, kind])
  @@index([completedAt])
}
