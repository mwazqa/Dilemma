generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizSettlement {
  messageId       String    @id
  guildId         String
  channelId       String
  difficulty      String
  correctAnswerId Int
  answerIds       String
  expiresAt       DateTime
  closedAt        DateTime?
  scoredAt        DateTime?
  nextCheckAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  answers         QuizAnswer[]

  @@index([scoredAt, nextCheckAt])
  @@index([guildId])
}

model QuizAnswer {
  messageId  String
  userId     String
  guildId    String
  answerId   Int
  correct    Boolean
  points     Int
  finishedAt DateTime
  settlement QuizSettlement @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([guildId, userId, finishedAt, messageId])
}

model UserScore {
  guildId       String
  userId        String
  points        Int      @default(0)
  answered      Int      @default(0)
  correct       Int      @default(0)
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@id([guildId, userId])
  @@index([guildId, points])
}


model DailyQuizRun {
  guildId   String
  scope     String
  day       String
  slot      Int
  messageId String?
  createdAt DateTime @default(now())

  @@id([guildId, scope, day, slot])
}

model Topic {
  id             String   @id @default(cuid())
  guildId        String
  name           String
  language       String   @default("en")
  difficulty     String   @default("medium")
  intervalDays   Int      @default(1)
  pollDurationHours Int   @default(24)
  options        String
  optionCount    Int      @default(4)
  questionsGenerated Int   @default(0)
  channelId      String?
  enabled        Boolean  @default(true)
  nextGenerationAt DateTime?
  generationTime String?
  lastGeneratedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([guildId, name])
  @@index([guildId])
}

model GuildSettings {
  guildId   String   @id
  language          String   @default("en")
  defaultIntervalDays Int    @default(1)
  defaultPollDurationHours Int @default(24)
  defaultDifficulty String @default("medium")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GeneratedPoll {
  difficulty    String    @default("medium")
  id            String    @id @default(cuid())
  guildId       String
  topicId       String
  messageId     String    @unique
  channelId     String
  question     String
  options      String
  correctOption Int
  explanation  String
  topicEmoji   String    @default("✨")
  optionEmojis String    @default("")
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([guildId, createdAt])
}

model RandomPoll {
  difficulty    String    @default("medium")
  id            String    @id @default(cuid())
  guildId       String
  language      String
  messageId     String    @unique
  channelId     String
  question      String
  options       String
  correctOption Int
  explanation   String
  optionEmojis  String    @default("")
  createdAt     DateTime  @default(now())
  endedAt       DateTime?

  @@index([guildId, createdAt])
}
